; Function SuspendAllInterrupts
SuspendAllInterrupts:	.type	func

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   107  {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   108    uint32 CoreId;
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   109  
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   110    /* Get the current core id */
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   111    CoreId = Mcal_GetCpuIndex();
	call	Mcal_GetCpuIndex

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   112  
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   113    if(Os_IntSaveDisableCounter[CoreId] == 0)
	fcall	.cocofun_1
	jne	d15,#0,.L2

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   114    {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   115      Os_SavedIntLevelNested[CoreId] = MFCR(CPU_ICR);/* disable interrupts */
	movh.a	a2,#@his(Os_SavedIntLevelNested)
	lea	a2,[a2]@los(Os_SavedIntLevelNested)
	addsc.a	a2,a2,d2,#2
	mfcr	d15,#65068
	st.w	[a2],d15

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   116      DISABLE();
	disable
.L2:

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   117    }
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   118    Os_IntSaveDisableCounter[CoreId]++;
	ld.bu	d15,[a15]
	add	d15,#1
	st.b	[a15],d15

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   119  }
	ret
	
