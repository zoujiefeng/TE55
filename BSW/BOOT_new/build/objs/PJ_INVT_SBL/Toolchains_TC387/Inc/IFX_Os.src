; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   136  **                                                                            **
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   137  ** Description      : This function Resumes all interrupts, nested            **
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   138  **                                                                            **
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   139  *******************************************************************************/
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   140  void ResumeAllInterrupts(void)
; Function ResumeAllInterrupts
ResumeAllInterrupts:	.type	func

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   141  {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   142    uint32 CoreId;
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   143  
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   144    /* Get the current core id */
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   145    CoreId = Mcal_GetCpuIndex();
	call	Mcal_GetCpuIndex

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   146  
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   147    if (Os_IntSaveDisableCounter[CoreId] > 0)
	fcall	.cocofun_1
	jeq	d15,#0,.L3

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   148    {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   149      Os_IntSaveDisableCounter[CoreId]--;
	ld.bu	d15,[a15]
	add	d15,#-1
	st.b	[a15],d15
.L3:

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   150    }
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   151  
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   152    if (Os_IntSaveDisableCounter[CoreId] == 0)
	ld.bu	d15,[a15]
	jne	d15,#0,.L4

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   153    {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   154      if (Os_SavedIntLevelNested[CoreId] & (0x00000001U << 15))
	movh.a	a15,#@his(Os_SavedIntLevelNested)
	lea	a15,[a15]@los(Os_SavedIntLevelNested)
	addsc.a	a15,a15,d2,#2
	ld.w	d15,[a15]
	jz.t	d15:15,.L5

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   155      {
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   156        /* interrupts were enabled, enable again */
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   157        ENABLE();
	enable
.L5:
.L4:

; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   158      }
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   159    }
; Sbl\Toolchains_TC387\Inc\IFX_Os.c	   160  }
	ret
	
