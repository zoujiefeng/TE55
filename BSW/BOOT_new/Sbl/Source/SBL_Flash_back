#define FLASH_DRIVER_MAX_OF_BYTE_TO_WRITE   1024
#define FLASH_DRIVER_MIN_OF_BYTE_TO_WRTIE   256

#define ECUMGR_ERASE_SEGMENT_SIZE           (0x4000u)

uint8 errId;
#define FLASH_HEADER_START_SEC_FLS_HDR
#include"MemMap.h"
const tFlashHeader FlashHeader =
{
    SBL_FlashInit,
    SBL_FlashDeinit,
    SBL_FlashErase,
