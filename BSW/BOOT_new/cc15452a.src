; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   314   * Pointer to the current job state
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   315   * \param [inout] JobResult_pst
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   316   * Pointer to the job results,  possible values:
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   317   * - NvM_Prv_JobResult_Pending_e   = Cryptographic services are still pending -> wait 1 cycle
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   318   * - NvM_Prv_JobResult_Failed_e    = Cryptographic services has failed -> finish job
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   319   * - NvM_Prv_JobResult_Succeeded_e = Cryptographic services has succeeded -> append administrative data
