; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   207   * \brief
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   208   * This local private function is a write job step function and recalculates the CRC over user data if configured.
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   209   * \details
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   210   * The NvM reaches this job step only if job buffer contains user data.
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   211   *
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   212   * This function determines further job steps dependent on the RAM CRC configuration
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   213   * - RAM CRC configured    = check if user has changed data compared to last successful read/write/restore ->
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   214   *                           - user has changed data     -> continue with cryptographic services
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   215   *                           - user has not changed data -> finish job
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   216   * - no RAM CRC configured = continue with cryptographic services
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   217   *
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   218   * \param [inout] stJob_pen
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   219   * Pointer to the current job state
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   220   * \param [inout] JobResult_pst
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   221   * Pointer to the job results,  possible values:
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   222   * - NvM_Prv_JobResult_Pending_e                = CRC recalculation is still pending -> wait 1 cycle
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   223   * - NvM_Prv_JobResult_Succeeded_e              = CRC recalculation has succeeded or not configured, user data changed ->
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   224   *                                                continue with cryptographic services
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   225   * - NvM_Prv_JobResult_Succeeded_MemIfSkipped_e = CRC recalculation has succeeded, user data not changed ->
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   226   *                                                finish job
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   227   * \param [in] JobData_pcst
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   228   * Constant pointer to the job data
; Fbl\BSW\Bsw_Gen\NvM\src\Internal\JobHandling\NvM_JobWrite.c	   229   */
