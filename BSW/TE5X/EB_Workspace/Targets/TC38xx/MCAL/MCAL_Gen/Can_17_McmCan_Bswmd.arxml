            <INTERNAL-BEHAVIORS>
              <BSW-INTERNAL-BEHAVIOR>
                <SHORT-NAME>CanBehavior</SHORT-NAME>
                <EXCLUSIVE-AREAS>
                  <EXCLUSIVE-AREA>
                    <SHORT-NAME>CanIntCtrl</SHORT-NAME>
                    <INTRODUCTION>
                      <NOTE SI="User of CAN Interrupt enabling and disabling function shall ensure that the critical section protection provided by CAN for protecting the controlling of the interrupts is implemented by using suspend and resume of interrupts" NOTE-TYPE="HINT"/>
                    </INTRODUCTION>
                  </EXCLUSIVE-AREA>
                  <EXCLUSIVE-AREA>
                    <SHORT-NAME>IcomMsgCntrVal</SHORT-NAME>
                    <INTRODUCTION>
                      <NOTE SI="User of CAN pretended networking functionality shall ensure that the critical section protection provided by CAN for protecting the ICOM message counter value is implemented by using suspend and resume of interrupts" NOTE-TYPE="HINT"/>
                    </INTRODUCTION>
                  </EXCLUSIVE-AREA>
                  <EXCLUSIVE-AREA>
                    <SHORT-NAME>CanWrMO</SHORT-NAME>
                    <INTRODUCTION>
                      <NOTE SI="User of CAN write operation shall ensure that the critical section protection provided by CAN for protecting the write operation sequence is implemented by using suspend and resume of interrupts" NOTE-TYPE="HINT"/>
                    </INTRODUCTION>
                  </EXCLUSIVE-AREA>
                </EXCLUSIVE-AREAS>
