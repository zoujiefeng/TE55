void AESM_vidOnAESM_EV0(void)
{
   do { (AESM_bfOutEventCarrier = 0); (*AESM_pfDuringAESM_STF0OnAESM_EV0Ptr)(); (*AESM_pfTransAESM_STF0OnAESM_EV0Ptr)(); } while(0);
}
void AESM_vidOnAESM_EV1(void)
{
   do { (AESM_bfOutEventCarrier = 0); (*AESM_pfDuringAESM_STF0OnAESM_EV1Ptr)(); (*AESM_pfTransAESM_STF0OnAESM_EV1Ptr)(); } while(0);
}




void AESM_vidExecOutEvent(uint16 bfCarrier)
{
   if ((bfCarrier & (uint16)(1 << 0)) != 0)
   {
      AESM_StpIState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 1)) != 0)
   {
      AESM_StpIINfState = 1; AESM_StpIIFtState = 1; AESM_PwrLFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 2)) != 0)
   {
      AESM_OpNfState = 1; AESM_OpFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 3)) != 0)
   {
      AESM_PwrLNfState = 1; AESM_PwrLFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 4)) != 0)
   {
      AESM_PwrLNfState = 16384;;
   }
}



