}
void ESM_vidOnESM_EV1(void)
{
   do { (ESM_bfOutEventCarrier = 0); (*ESM_pfDuringESM_STF0OnESM_EV1Ptr)(); (*ESM_pfTransESM_STF0OnESM_EV1Ptr)(); } while(0);
}




void ESM_vidExecOutEvent(uint16 bfCarrier)
{
   if ((bfCarrier & (uint16)(1 << 0)) != 0)
   {
      ESM_StpIState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 1)) != 0)
   {
      ESM_StpIINfState = 1; ESM_StpIIFtState = 1; ESM_PwrLFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 2)) != 0)
   {
      ESM_OpNfState = 1; ESM_OpFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 3)) != 0)
   {
      ESM_PwrLNfState = 1; ESM_PwrLFtState = 1;;
   }
   if ((bfCarrier & (uint16)(1 << 4)) != 0)
   {
      ESM_PwrLNfState = 16384;;
   }
}



