static inline __attribute__ ((always_inline)) void IfxGtm_Pwm_updateChannelPhase(IfxGtm_Pwm *pwm, IfxGtm_Pwm_SyncChannelIndex configIndex, float32 requestPhase)
{
    IfxGtm_Pwm_Channel *channel = &pwm->channels[configIndex];


    uint32 phaseTicks = (uint32)((float32)(((float32)pwm->periodTicks * requestPhase * (1.0f / (2.0f * (3.1415926535897932384626433832795f)))) + (float32)0.5f));


    uint32 dutyTicks = (channel->dutyTicks - channel->phaseTicks) + phaseTicks;


    channel->phaseTicks = phaseTicks;
    channel->dutyTicks = dutyTicks;


    *channel->registers.SR0 = phaseTicks;
    *channel->registers.SR1 = (dutyTicks <= pwm->periodTicks) ? dutyTicks : dutyTicks - pwm->periodTicks;
}


static inline __attribute__ ((always_inline)) void IfxGtm_Pwm_updateChannelPhaseImmediate(IfxGtm_Pwm *pwm, IfxGtm_Pwm_SyncChannelIndex configIndex, float32 requestPhase)
{
    IfxGtm_Pwm_Channel *channel = &pwm->channels[configIndex];


    uint32 phaseTicks = (uint32)((float32)(((float32)pwm->periodTicks * requestPhase * (1.0f / (2.0f * (3.1415926535897932384626433832795f)))) + (float32)0.5f));


    uint32 dutyTicks = (channel->dutyTicks - channel->phaseTicks) + phaseTicks;


    channel->phaseTicks = phaseTicks;
    channel->dutyTicks = dutyTicks;

    dutyTicks = (dutyTicks <= pwm->periodTicks) ? dutyTicks : dutyTicks - pwm->periodTicks;


    *channel->registers.SR0 = phaseTicks;
    *channel->registers.SR1 = dutyTicks;
    *channel->registers.CM0 = phaseTicks;
    *channel->registers.CM1 = dutyTicks;
}


static inline __attribute__ ((always_inline)) void IfxGtm_Pwm_updateChannelDuty(IfxGtm_Pwm *pwm, IfxGtm_Pwm_SyncChannelIndex configIndex, float32 requestDuty)
{
    IfxGtm_Pwm_Channel *channel = &pwm->channels[configIndex];


    uint32 dutyTicks = (uint32)((float32)(((float32)pwm->periodTicks * requestDuty * 0.01f) + (float32)0.5f));


    if (pwm->alignment != IfxGtm_Pwm_Alignment_edge)
    {
        dutyTicks = pwm->periodTicks - dutyTicks;
        channel->dutyTicks = dutyTicks;
    }

    else
    {
        dutyTicks += channel->phaseTicks;
        channel->dutyTicks = dutyTicks;
        dutyTicks = (dutyTicks <= pwm->periodTicks) ? dutyTicks : dutyTicks - pwm->periodTicks;
    }


    *channel->registers.SR1 = dutyTicks;
}


static inline __attribute__ ((always_inline)) void IfxGtm_Pwm_updateChannelDutyImmediate(IfxGtm_Pwm *pwm, IfxGtm_Pwm_SyncChannelIndex configIndex, float32 requestDuty)
{
    IfxGtm_Pwm_Channel *channel = &pwm->channels[configIndex];


    uint32 dutyTicks = (uint32)((float32)(((float32)pwm->periodTicks * requestDuty * 0.01f) + (float32)0.5f));


    if (pwm->alignment != IfxGtm_Pwm_Alignment_edge)
    {
        dutyTicks = pwm->periodTicks - dutyTicks;
        channel->dutyTicks = dutyTicks;
    }

    else
    {
        dutyTicks += channel->phaseTicks;
        channel->dutyTicks = dutyTicks;
        dutyTicks = (dutyTicks <= pwm->periodTicks) ? dutyTicks : dutyTicks - pwm->periodTicks;
    }


    *channel->registers.SR1 = dutyTicks;
    *channel->registers.CM1 = dutyTicks;
}


static inline __attribute__ ((always_inline)) void IfxGtm_Pwm_updateChannelDeadTimeImmediate(IfxGtm_Pwm *pwm, IfxGtm_Pwm_SyncChannelIndex configIndex, IfxGtm_Pwm_DeadTime requestDeadTime)
{
    IfxGtm_Pwm_Channel *channel = &pwm->channels[configIndex];


    if (channel->registers.DTV != ((void *)0))
    {
        Ifx_GTM_CDTM_DTM_CH_DTV dtvReg;


        uint32 risingTicks = (uint32)((float32)((requestDeadTime.rising * pwm->dtmFrequency) + (float32)0.5f));
        uint32 fallingTicks = (uint32)((float32)((requestDeadTime.falling * pwm->dtmFrequency) + (float32)0.5f));


        dtvReg.B.RELRISE = (uint16)risingTicks;
        dtvReg.B.RELFALL = (uint16)fallingTicks;


        *channel->registers.DTV = dtvReg.U;
    }
}
