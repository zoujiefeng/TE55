   pInit->vidLinkPwmChConfigAndDtmConfig(&xPwmChConfig[0], &xPwmDtmConfig[0]);
   pInit->vidLinkPwmConfigAndIntConfig(&xPwmChConfig[0], &xPwmIntConfig);
