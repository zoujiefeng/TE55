OPTION opt 
{ 
/*******************************************************************************
; les options par defaut ont les valeurs suivantes : (cf. Panne.stx) 
;
;  GROUPE = "Diagnostic_9";
;  GROUPE_1 = "d_Diagnostic";
;  d'autres options peuvent etre rajoutees suivant les besoins (ne pas 
;  oublier de les definir dans le fichier Fault.stx qui contient la 
;  definition de la syntaxe utilisee)
;******************************************************************************/
   GROUPE             = "DSM";
   GROUPE_1           = "FAULT_FF";
   ENDIANNESS         = INTEL;
   FREEZEFRAME_LENGTH = 350;
};

/*******************************************************************************
;*******************************************************************************
;
;Common fault context (FF1): 350 bytes
