#******************************************************************************/
#*                                                                            */
#* !Layer           : -                                                       */
#*                                                                            */
#* !Component       : -                                                       */
#*                                                                            */
#* !Description     : _FileSubPrj.hex generation                              */
#*                  : Input  : _FileSubPrj.h86                                */
#*                  : Input  : *.bd3                                          */
#*                  : Output : _FileSubPrj_calib.hex                          */
#*                  : Output : _FileSubPrj_code.hex                           */
#*                  : Output : _FileSubPrj.hex                                */
#*                                                                            */
#* !File            : GeneUlp.tfm                                             */
#*                                                                            */
#* !Scope           : Public                                                  */
#*                                                                            */
#* !Target          : TC264                                                   */
#*                                                                            */
#* !Vendor          : invt                                                    */
#*                                                                            */
#* Coding language  : Transfor                                                */
#*                                                                            */
#* COPYRIGHT 2009 invt                                                        */
#* all rights reserved                                                        */
#*                                                                            */
#******************************************************************************/
#* SVN Information                                                           */
#* $Archive::       $*/
#* $Revision::   1.4      $$Author::          $$Date::   21 Mar 2012 $*/
#******************************************************************************/
/psa
/cpu:intel

#*****************************************************************/
# Start Code Block0
#*****************************************************************/
#********************/
# Convert Hex To S19
#********************/
open /file_name:%SrcHexPATH%.hex /buf_dest:1 /overlap
save /buf_src:1 /file_name:%SrcHexPATH%.s19 /format:mot
#*****************************************************************/
# End Code Block0
#*****************************************************************/

#*********************************************************************************************************************************/
#                                                          Parting line
#*********************************************************************************************************************************/
#*****************************************************************/
# Start Code Block1
#*****************************************************************/
#********************/
# Extract DFM Tcu Calibration
#********************/
open /file_name:%DFM_TCUCALPATH%.s19 /buf_dest:2 /overlap
fill_buf /buf_dest:3 /addr_src:80058000 /size:8000 /pattern:00
extract /buf_src:2 /buf_dest:4 /addr_src:80058000 /size:8000
cat /buf_list:3,4 /buf_dest:5 /overlap

#/* Debug cmd */
#save /buf_src:5 /file_name:TCU_CALUSR_FILLED.ulp /format:mot
#*****************************************************************/
# End Code Block1
#*****************************************************************/

#*********************************************************************************************************************************/
#                                                          Parting line
#*********************************************************************************************************************************/
#*****************************************************************/
# Start Code Block2    App Length 0x2A8000
#*****************************************************************/
# Add DFM Tcu Calibration To App
# Fill 0xCC
# App Length 0x2A8000
#*****************************************************************/
fill_buf /buf_dest:6 /addr_src:80058000 /size:2A8000 /pattern:CC
extract /buf_src:1 /buf_dest:7 /addr_src:80058000 /size:2A8000
cat /buf_list:6,7 /buf_dest:8 /overlap

#*****************************************************************/
#/* if Not Add Tcu calib */  
#*****************************************************************/
save /buf_src:8 /file_name:%AppPATH%.s19 /format:mot
#*****************************************************************/
#/* else if Add TCU Calib */
#*****************************************************************/
#cat /buf_list:8,5 /buf_dest:9 /overlap
#save /buf_src:9 /file_name:%AppPATH%.s19 /format:mot
#*****************************************************************/
# End Code Block2    App Length 0x2A8000
#*****************************************************************/

#*********************************************************************************************************************************/
#                                                          Parting line
#*********************************************************************************************************************************/
#*****************************************************************/
# Start Code Block3    App Length 0x1A8000
#*****************************************************************/
# Add DFM Tcu Calibration To App
# Fill 0xCC
# App Length 0x1A8000
#*****************************************************************/
#fill_buf /buf_dest:10 /addr_src:80058000 /size:1A8000 /pattern:CC
#extract /buf_src:1 /buf_dest:12 /addr_src:80058000 /size:1A8000
#cat /buf_list:10,12 /buf_dest:13 /overlap

#*****************************************************************/
#/* if Not Add Tcu calib */  
#*****************************************************************/
#save /buf_src:13 /file_name:%AppPATH%_SmallRange.s19 /format:mot

#*****************************************************************/
#/* else if Add TCU Calib */
#*****************************************************************/
#cat /buf_list:13,5 /buf_dest:14 /overlap
#save /buf_src:14 /file_name:%AppPATH%_SmallRange.s19 /format:mot

#*****************************************************************/
# End Code Block3    App Length 0x1A8000
#*****************************************************************/
