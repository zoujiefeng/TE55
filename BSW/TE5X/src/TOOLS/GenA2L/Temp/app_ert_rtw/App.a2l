      /* Long identifier        */      "Q = V*16384.000000"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%15.14"
      /* Units                  */      "NA (none)"
      /* Coefficients           */      COEFFS 0  16384      0      0      0      1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_BOOLEAN
      /* Long identifier        */      "Q = V"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%1.0"
      /* Units                  */      "Bool"
      /* Coefficients           */      COEFFS 0  1  0  0  0  1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_P_kW_128_1_s16
      /* Long identifier        */      "Q = V*128.000000"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%10.7"
      /* Units                  */      "kW (kilowatts  (kW))"
      /* Coefficients           */      COEFFS 0  128    0    0    0    1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_Cnt_Num_1_1_u8
      /* Long identifier        */      "Q = V"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%3.0"
      /* Units                  */      "Num (counts)"
      /* Coefficients           */      COEFFS 0  1  0  0  0  1
    /end COMPU_METHOD
    
    
  
  
