    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_Busbar_LatchTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for setting and latching indication that Busbar is close to overcurrent
      ### Usage
      Set to desired ratio for indicating Busbar too close to overcurrent, will set latching when TCFRve_r_Busbar_Y is greater than or equal to this value
      ### Calibration Note
      This value is compared to TCFRve_r_Busbar_Y, when this exceeds 1 the Busbar powerstage will be turned off by BSW
      The indication is released when TCFRve_r_Busbar_Y is equal or less than TCFRke_r_Busbar_ReleaseTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with TCFRke_Busbar_EnableTooCloseToOverCurrent
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_Busbar_LatchTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_Busbar_ReleaseTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for releasing indication that Busbar is close to overcurrent
      ### Usage
      Set to desired ratio for releasing Busbar too close to overcurrent, will release latching when TCFRve_r_Busbar_Y is equal to or less than this value
      ### Calibration Note
      This value is compared to TCFRve_r_Busbar_Y, when this exceeds 1 BSW will turn off BLDCs
      The indication is set and latched when TCFRve_r_Busbar_Y is greater than or equal to TCFRke_r_Busbar_LatchTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with TCFRke_Busbar_EnableTooCloseToOverCurrent
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_Busbar_ReleaseTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_Busbar_Y_OverCurrentMargin 
      /* Long Identifier        */      "### Description
      This is the margin for Busbar overcurrent filter load value Y, used to prevent Busbar Overcurrent.
      The speed limit will be reduced when the margin (relative to 1) is smaller than this value
      ### Usage
      Set to desired minimum margin for filtered load current before flow limitation is reduced
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_Busbar_Y_OverCurrentMargin@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_FlowLimitationRateLimY 
      /* Long Identifier        */      "This sets which rate limiter parameters shall be used based on TCFCve_r_SumCur_Y, for rate-limitation of CCP flow limitation based current usage."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCur_FlowLimitationRateLimY@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
