      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      VSPEke_b_UseTOSForSpeedDir 
      /* Long Identifier        */      "If true the sign of transaction decides the sign of driven wheel speed. Else the sign of driven wheel is given by the range selector position."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@VSPEke_b_UseTOSForSpeedDir@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
