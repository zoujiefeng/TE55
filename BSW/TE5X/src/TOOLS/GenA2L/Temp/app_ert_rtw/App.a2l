    /begin CHARACTERISTIC      
      /* Name                   */      CLCOkt_M_OddInProgRampOnRateOld
      /* Long Identifier        */      "Ramp in rate as function of old clutch torque, makes it possible to request toque faster after clutch is closed.
      
      Fix solution to engage gear faster in PHEV2 project where it is important to request 0.8 A when clutch is closed...
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@CLCOkt_M_OddInProgRampOnRateOld@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_M_Nm_32_1_s16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      100.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -1024.0
      /* Extended Upper Limit   */      1023.96875
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      CLCOve_M_A6
        /* Conversion Method    */      CM_T_M_Nm_32_1_s16
        /* Number of Axis Pts   */      3
        /* Lower Limit          */      0.0
        /* Upper Limit          */      100.0
        AXIS_PTS_REF                    CLCOkn_M_InProgRampRateOld
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
