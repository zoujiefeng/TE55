    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_R_CAPM_InternalResistance 
      /* Long Identifier        */      "### Description
      This is the estimated internal resistance in the CAPM BLDC
      ### Usage
      Set to estimated internal resistance for CAPM BLDC
      ### Calibration Note
      This is used by the CAPM speed controller feed forward due to clutch pressure"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_R_CAPM_InternalResistance@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_R_ohm_1024_1_s16 
      /* Lower Limit            */      0.0009765625 
      /* Upper Limit            */      31.875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32.0
      /* Extended Upper Limit   */      31.9990234375
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_l_ClutchNetRadiusEven 
      /* Long Identifier        */      "Clutch Net Radius.
      
      NR=(R^3-r^3)/(R^2-r^2)*2/3
      
      Where:
      R = Clutch outer radius (contact surface)
      r = Clutch inner radius (contact surface)
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_l_ClutchNetRadiusEven@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_l_m_1024_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32.0
      /* Extended Upper Limit   */      31.9990234375
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_l_ClutchNetRadiusOdd 
      /* Long Identifier        */      "Clutch Net Radius.
      
      NR=(R^3-r^3)/(R^2-r^2)*2/3
      
      Where:
      R = Clutch outer radius (contact surface)
      r = Clutch inner radius (contact surface)
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_l_ClutchNetRadiusOdd@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
