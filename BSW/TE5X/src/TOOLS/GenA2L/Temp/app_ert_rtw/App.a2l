      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_SpeedControllerEnable 
      /* Long Identifier        */      "### Description
      This enables CAPM speed control
      ### Usage
      Set to true if speed control shall be enabled
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_SpeedControllerEnable@ */ 
