    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_r_CCPM_SpeedLimitationRateLimY 
      /* Long Identifier        */      "This sets which rate limiter parameters shall be used based on TCFCve_r_CCP_Y, for rate-limitation of CCPM speed limitation based current usage.
      
      If TCFCve_r_CCP_Y is equal to or greater than this value, then TCFCke_n_CCPM_LimitationHighY_Increase and TCFCke_n_CCPM_LimitationHighY_Decrease will be used.
      Otherwise TCFCke_n_CCPM_LimitationLowY_Increase and TCFCke_n_CCPM_LimitationLowY_Decrease will be used
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_r_CCPM_SpeedLimitationRateLimY@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.999969482421875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_r_CCP_Y_OverCurrentMargin 
      /* Long Identifier        */      "### Description
      This is the margin for CCP overcurrent filter load value Y, used to prevent CCP Phase Overcurrent.
      The speed limit will be reduced when the margin (relative to 1) is smaller than this value
      ### Usage
      Set to desired minimum margin for filtered load current before target speed is reduced
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_r_CCP_Y_OverCurrentMargin@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_CCPM_ChangeBLDC_Direction 
      /* Long Identifier        */      "### Description
      This enables changes the direction of CCPM BLDC
      ### Usage
      Set to true if CCPM BLDC direction shall be changed
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_CCPM_ChangeBLDC_Direction@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_CCPM_CommandDBC_Enable 
      /* Long Identifier        */      "CCPM_DBC_control_enable"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_CCPM_CommandDBC_Enable@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_CCPM_OverCurrent_UseBSW_Limit 
      /* Long Identifier        */      "### Description
      This enables indicating using the BSW CCPM BLDC filtered overcurrent limit for CurrentBasedMaxSpeed
      ### Usage
      Set to true to use information from BSW as well as (max of) the calculated value in TCFC
      Set to false to only use the calculated value in TCFC
      ### Calibration Note
      The BSW value can be measured with TCFCve_r_CCP_BSW_Y and the TCFC value with TCFCve_r_CCP_Y"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_CCPM_OverCurrent_UseBSW_Limit@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_CCPM_SpeedControlDutyCompVoltageCompEnable 
      /* Long Identifier        */      "### Description
      This enables voltage compensation of MotorSupply voltage of CCPM for speed control duty-cycle compensation
      ### Usage
      Set to true if voltage compensation for feed-forward shall be enabled
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_CCPM_SpeedControlDutyCompVoltageCompEnable@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_DebouncedRoundingOfOilTempForSpeedLimit 
      /* Long Identifier        */      "### Description
      This enables rounding of oil temp value that is used for temperature based speed limit of cooling circuit
      When enabled the used oil temp is rounded to complete degrees C, with some hysterisis when switching.
      ### Usage
      Set to true to enable rounding of oil temp for cooling circuit speed limit
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_DebouncedRoundingOfOilTempForSpeedLimit@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_b_UseCurrentBasedMaxSpeed 
      /* Long Identifier        */      "This enables using a min of the temperature dependent max speed and a max speed based on used current relative to max-limit for max CCPM speed.
      
      If set to false, onlu temperature dependent max speed is used.
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_b_UseCurrentBasedMaxSpeed@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
