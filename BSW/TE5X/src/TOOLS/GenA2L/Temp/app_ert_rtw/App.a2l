      /* Upper Limit            */      1000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_DelayToDisableSpeedController 
      /* Long Identifier        */      "This is the minimum target speed to enable the CAPM speed controller, if below this limit, for more time than specified with CLPCke_n_CAPM_MinSpeedToEnableController then the controller will be disabled and output duty-cycle set to 0"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_DelayToDisableSpeedController@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_DisableCAP_ClutchOpenReq 
      /* Long Identifier        */      "This specifies the maximum time that the CAP actuator is enabled after ClutchOpenReq is set, in counts of periodic sample time (@10ms)"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_DisableCAP_ClutchOpenReq@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
