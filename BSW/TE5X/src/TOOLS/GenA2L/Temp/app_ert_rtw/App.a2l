    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_I_Busbar_BSW_CurrentLimit 
      /* Long Identifier        */      "### Description
      This is the BSW current limit for Busbar Current
      ### Usage
      Set to the same value as used in BSW
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_I_Busbar_BSW_CurrentLimit@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_I_A_Float32 
      /* Lower Limit            */      0.1 
      /* Upper Limit            */      3.4E+38
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_I_MinLubricationCurrentRampDown 
      /* Long Identifier        */      "This is the maximum ramp-down of \"stored\" busbar current needed for MinLubrication flow, it is used when at MinLubrication flow and when above MinLubrication and the current is below the \"stored\" MinLubrication current."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_I_MinLubricationCurrentRampDown@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_I_A_Float32 
      /* Lower Limit            */      -1024.0 
      /* Upper Limit            */      0.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_I_MinLubricationCurrentRampUp 
      /* Long Identifier        */      "This is the maximum ramp-up of \"stored\" busbar current needed for MinLubrication flow, it is used when at MinLubrication flow"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_I_MinLubricationCurrentRampUp@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_I_A_Float32 
      /* Lower Limit            */      0.03125 
      /* Upper Limit            */      3.4E+38
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
