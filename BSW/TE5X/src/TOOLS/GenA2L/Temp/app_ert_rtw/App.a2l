    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_EnablePressureControl 
      /* Long Identifier        */      "### Description
      This enables CAPM pressure control
      ### Usage
      Set to true if pressure control shall be enabled
      ### Calibration Note
      For CAPM pressure control to be acknowleged, CAPM speed control also needs to be enabled"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_EnablePressureControl@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_OverCurrent_UseBSW_Limit 
      /* Long Identifier        */      "### Description
      This enables indicating using the BSW CAPM BLDC filtered overcurrent limit for CurrentBasedMaxSpeed
      ### Usage
      Set to true to use information from BSW as well as (max of) the calculated value in CLPC
      Set to false to only use the calculated value in CLPC
      ### Calibration Note
      The BSW value can be measured with CLPCve_r_CAP_BSW_Y and the CLPC value with CLPCve_r_CAP_Y"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_OverCurrent_UseBSW_Limit@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_PressureControlIPartCompOfOverReq 
      /* Long Identifier        */      "### Description
      This enables some anti-windup in CAPM pressure controller when speed controller is saturated
      ### Usage
      Set to true to reduce pressure controller I-part when speed controller is saturated
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_PressureControlIPartCompOfOverReq@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_PressureControl_PIDuse 
      /* Long Identifier        */      ""
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_PressureControl_PIDuse@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_PressureTestSequenceEnable 
      /* Long Identifier        */      "### Description
      This enables the target pressure test sequence generator for Clutch Actuator Pump Motor
      ### Usage
      Set to TRUE to enable the sequence generator
      ### Calibration Note
      This only enables the generator, not that the output is used, the sequence generator output is CLPCve_p_CAPM_PressureTestSequenceTarget
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_PressureTestSequenceEnable@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAPM_SpeedControlDutyCompVoltageCompEnable 
      /* Long Identifier        */      "### Description
      This enables voltage compensation of MotorSupply voltage of CAPM for speed control duty-cycle compensation
      ### Usage
      Set to true if voltage compensation for feed-forward shall be enabled
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAPM_SpeedControlDutyCompVoltageCompEnable@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
