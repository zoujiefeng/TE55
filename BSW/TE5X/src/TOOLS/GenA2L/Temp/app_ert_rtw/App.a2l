    /begin CHARACTERISTIC      
      /* Name                   */      CLPCkt_Pct_CAPM_DutyCompensation
      /* Long Identifier        */      "### Description
      This is the DC compensation for CAPM needed to maintain a certain speed
      ### Usage
      Set to measured DC needed to maintain each speed in the support point axis
      ### Calibration Note
      Support point axis are calibrated with CLPCkn_n_CAPM_Target
      It may not be possible to achieve all speeds without creating to high pressure
      This feed-forward is highly dependent on supply voltage to BLDC power stage, this calibration is against the supply-voltage in CLPCke_U_CAPM_NominalVoltage
      Typically, for no load the comensation would be linear, matching a kV for the motor, if the load (due to pressure) is handled by the other feed-forward.
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkt_Pct_CAPM_DutyCompensation@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_Pct_pct_256_1_s16
      /* Lower Limit            */      -128.0
      /* Upper Limit            */      127.99609375
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -128.0
      /* Extended Upper Limit   */      127.99609375
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      NO_INPUT_QUANTITY
        /* Conversion Method    */      CM_T_n_rpm_1_1_s16
        /* Number of Axis Pts   */      16
        /* Lower Limit          */      -32768.0
        /* Upper Limit          */      32767.0
        AXIS_PTS_REF                    CLPCkn_n_CAPM_Target
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
      /* Name                   */      CLPCkn_n_CAPM_Target
      /* Long Identifier        */      "### Description
      This is the support point axis for DC compensation for CAPM needed to maintain a certain speed
      ### Usage
      Set to desired support points
      ### Calibration Note
      
      "
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkn_n_CAPM_Target@ */
      /* Input Quantity         */      NO_INPUT_QUANTITY
      /* Record Layout          */      Lookup1D_X_WORD
      /* Maximum Difference     */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Number of Axis Pts     */      16
      /* Lower Limit            */      -32768.0
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end AXIS_PTS
    /begin CHARACTERISTIC      
      /* Name                   */      CLPCkt_n_CAPM_Fill
      /* Long Identifier        */      "iption
      This is the extra speed part for fill compensation, to reach the target fill pressure (or kisspoint if target is above kisspoint).
      ### Usage
      Set to desired extra fill speed depending on \"fill pressure diff\" and oil temperature.
      ### Calibration Note
      To have any effect, this compensation needs to be enabled through CLPCke_b_EnableFillCompensation
      Support points axis are calibrated with CLPCkn_T_OilTemp_CAPM_Fill and CLPCkn_p_FillDiff_CAPM_Fill"
      /* Characteristic Type    */      MAP
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkt_n_CAPM_Fill@ */
      /* Record Layout          */      Lookup2D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /begin AXIS_DESCR                 
        /* Description of Y-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      CLPCve_p_FillDiff
        /* Conversion Method    */      CM_T_p_kPa_32_1_u16
        /* Number of Axis Pts   */      7
        /* Lower Limit          */      0.0
        /* Upper Limit          */      2047.96875
        AXIS_PTS_REF                    CLPCkn_p_FillDiff_CAPM_Fill
      /end AXIS_DESCR
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      CLPCve_T_TransOilSump
        /* Conversion Method    */      CM_T_T_degC_16_1_s16
        /* Number of Axis Pts   */      11
        /* Lower Limit          */      -2048.0
        /* Upper Limit          */      2047.9375
        AXIS_PTS_REF                    CLPCkn_T_OilTemp_CAPM_Fill
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
      /* Name                   */      CLPCkn_T_OilTemp_CAPM_Fill
      /* Long Identifier        */      "iption
      Support point axis relative to oil-temperature for extra speed part for fill compensation, to reach the target fill pressure (or kisspoint if target is above kisspoint).
      ### Usage
      Set to desired oil temperature support points
      ### Calibration Note
      This is used in table CLPCkt_n_CAPM_Fill"
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkn_T_OilTemp_CAPM_Fill@ */
      /* Input Quantity         */      CLPCve_T_TransOilSump
      /* Record Layout          */      Lookup2D_X_WORD
      /* Maximum Difference     */      0
      /* Conversion Method      */      CM_T_T_degC_16_1_s16
      /* Number of Axis Pts     */      11
      /* Lower Limit            */      -2048.0
      /* Upper Limit            */      2047.9375
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -2048.0
      /* Extended Upper Limit   */      2047.9375
    /end AXIS_PTS
    
    /begin AXIS_PTS
      /* Name                   */      CLPCkn_p_FillDiff_CAPM_Fill
      /* Long Identifier        */      "iption
      Support point axis relative to \"fill pressure diff\" (CLPCve_p_FillDiff = min(target, kisspoint) - actual) for extra speed part for fill compensation, to reach the target fill pressure (or kisspoint if target is above kisspoint).
      ### Usage
      Set to desired \"fill pressure diff\" support points
      ### Calibration Note
      This is used in table CLPCkt_n_CAPM_Fill"
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkn_p_FillDiff_CAPM_Fill@ */
      /* Input Quantity         */      CLPCve_p_FillDiff
      /* Record Layout          */      Lookup2D_X_UWORD
      /* Maximum Difference     */      0
      /* Conversion Method      */      CM_T_p_kPa_32_1_u16
      /* Number of Axis Pts     */      7
      /* Lower Limit            */      0.0
      /* Upper Limit            */      2047.96875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      2047.96875
    /end AXIS_PTS
    
    /begin CHARACTERISTIC      
      /* Name                   */      CLPCkt_n_CAPM_MaxFill
      /* Long Identifier        */      "This sets the maximum CAPM speed for fill, as a function of oil temperature
      If the fill is attempted to be mad to quickly, an increase in oil-pressure above kiss-point can be measured despite fill isn't complete
      This is due to the pressure sensor is located close to the pump, and then the oil needs to flow to the clutch and move the cylinder, if oil is pumped to quickly the pressure at the pump increases without oil has flowed to the clutch
      The fill speed needs to be set significantly lower when the oil is cold"
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkt_n_CAPM_MaxFill@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      CLPCve_T_TransOilSump
        /* Conversion Method    */      CM_T_T_degC_16_1_s16
        /* Number of Axis Pts   */      11
        /* Lower Limit          */      -2048.0
        /* Upper Limit          */      2047.9375
        AXIS_PTS_REF                    CLPCkn_T_OilTemp_MaxFill
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
