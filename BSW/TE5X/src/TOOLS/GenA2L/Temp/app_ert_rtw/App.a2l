    /begin CHARACTERISTIC      
      /* Name                   */      PORSkt_K_P1Weighting
      /* Long Identifier        */      "P1 speed and Engine speed weighting.
      in various RPM intervals (PORSkn_n_Intervals) P1 speed sensor influence on P1 rotational speed output can be weighted.
      
      Example:
      1 ->  100% P1 speed value will be used
      0.5 -> 50% P1/ICE speed. i.e mean value.
      0.1 -> 10% P1 value and 90% ICE sensor value will be used.
      
      
      
      
      
      
      
      
      
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSkt_K_P1Weighting@ */
      /* Record Layout          */      Lookup1D_UBYTE
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_K_NA_128_1_u8
      /* Lower Limit            */      0.0
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.9921875
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      PORSve_n_EngSpd
        /* Conversion Method    */      CM_T_n_rpm_1_1_s16
        /* Number of Axis Pts   */      11
        /* Lower Limit          */      0.0
        /* Upper Limit          */      10000.0
        AXIS_PTS_REF                    PORSkn_n_Intervals
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
      /* Name                   */      PORSkn_n_Intervals
      /* Long Identifier        */      "This vecor is used for both sensor weighting and LP filter coefficient settings for different rpm values"
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSkn_n_Intervals@ */
      /* Input Quantity         */      PORSve_n_EngSpd
      /* Record Layout          */      Lookup1D_X_WORD
      /* Maximum Difference     */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Number of Axis Pts     */      11
      /* Lower Limit            */      0.0
      /* Upper Limit            */      10000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end AXIS_PTS
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_e_P1RotationalSpeedVld_OV 
      /* Long Identifier        */      "###Description
      P1rotational speed validity output overide Value
      ###Calibration
      PORSke_e_P1RotationalSpeedVld_OV will be passed to the output if its corresponding OB value is enabled True(1)
      SPARce_e_Valid(0)
      SPARce_e_Invalid(1)
      SPARce_e_EstimatedReplaceValue(2)
      SPARce_e_NotEvaluatedYet(3)
      ###Usage
      For hardware test purpose only
      
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_e_P1RotationalSpeedVld_OV@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_SPARte_e_Validity 
      /* Lower Limit            */      0 
      /* Upper Limit            */      3
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_r_DiffDrvtvFiltrConst 
      /* Long Identifier        */      "###Description
      Derivative Filter constant  0p1 means that 10pct of the new value and 90pct of the old is used, 1 means that the new value is passed through unfiltered.
      
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_r_DiffDrvtvFiltrConst@ */ 
      /* Record Layout          */      Scalar_ULONG 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_A_m2_1024_1_u32 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      4.1943039990234375E+6
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_n_BypassFilter 
      /* Long Identifier        */      "Motor/Engine speed rpm below this value will bypass the filter."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_n_BypassFilter@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      15000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_n_MaxLimit 
      /* Long Identifier        */      "PORS output maximum value"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_n_MaxLimit@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32000.0 
      /* Upper Limit            */      32000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
