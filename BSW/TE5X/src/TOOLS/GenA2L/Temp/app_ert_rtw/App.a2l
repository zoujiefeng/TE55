      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_LatchLimitCAP_Current 
      /* Long Identifier        */      "### Description
      This is the ratio for activating and latching CAP Phase Current Limitation to avoid exceding SumCur (Sum Phase Current) limit
      ### Usage
      Set to desired ratio for activating and latching limit for CAP Phase current
      ### Calibration Note
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCur_LatchLimitCAP_Current@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      1.999969482421875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_LatchTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for setting and latching indication that SumCur is close to overcurrent
      ### Usage
      Set to desired ratio for indicating SumCur too close to overcurrent, will set latching when TCFRve_r_SumCur_Y is greater than or equal to this value
      ### Calibration Note
      This value is compared to TCFRve_r_SumCur_Y, when this exceeds 1 the SumCur powerstage will be turned off by BSW
      The indication is released when TCFRve_r_SumCur_Y is equal or less than TCFRke_r_SumCur_ReleaseTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with TCFRke_SumCur_EnableTooCloseToOverCurrent
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCur_LatchTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_ReleaseLimitCAP_Current 
      /* Long Identifier        */      "### Description
      This is the ratio for releasing CAP Phase Current Limitation to avoid exceding SumCur (Sum Phase Current) limit
      ### Usage
      Set to desired ratio for releasing limit for CAP Phase current
      ### Calibration Note
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCur_ReleaseLimitCAP_Current@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      1.999969482421875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_ReleaseTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for releasing indication that SumCur is close to overcurrent
      ### Usage
      Set to desired ratio for releasing SumCur too close to overcurrent, will release latching when TCFRve_r_SumCur_Y is equal to or less than this value
      ### Calibration Note
      This value is compared to TCFRve_r_SumCur_Y, when this exceeds 1 BSW will turn off BLDCs
      The indication is set and latched when TCFRve_r_SumCur_Y is greater than or equal to TCFRke_r_SumCur_LatchTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with TCFRke_SumCur_EnableTooCloseToOverCurrent
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCur_ReleaseTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCur_Y_OverCurrentMargin 
      /* Long Identifier        */      "### Description
      This is the margin for SumCur overcurrent filter load value Y, used to prevent SumCur Overcurrent.
      The speed limit will be reduced when the margin (relative to 1) is smaller than this value
      ### Usage
