    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_Pct_CCPM_DC 
      /* Long Identifier        */      "### Description
      This is the set value for output DC for CCPM BLDC
      ### Usage
      Set to desired DC command for CCPM BLDC
      ### Calibration Note
      This needs CCPM speed controller to be turned off to be used"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_Pct_CCPM_DC@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Pct_pct_10_1_s16 
      /* Lower Limit            */      -100.0 
      /* Upper Limit            */      100.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3276.8
      /* Extended Upper Limit   */      3276.7000000000003
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_Pct_CCPM_RateLimitDecrease 
      /* Long Identifier        */      "### Description
      This is the Decrease rate-limit for output duty-cycle for CCPM BLDC
      ### Usage
      Set to desired DC rate-limitation in Pct duty-cycle Decrease per sample (running at 2.5ms)
      ### Calibration Note
      Set as fast as possible, since speed controller doesn't expect/considers this rate limitation
      Negative Value!
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_Pct_CCPM_RateLimitDecrease@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Pct_pct_10_1_s16 
      /* Lower Limit            */      -3276.8 
      /* Upper Limit            */      -0.1
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3276.8
      /* Extended Upper Limit   */      3276.7000000000003
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_Pct_CCPM_RateLimitIncrease 
      /* Long Identifier        */      "### Description
      This is the Increase rate-limit for output duty-cycle for CCPM BLDC
      ### Usage
      Set to desired DC rate-limitation in Pct duty-cycle Increase per sample (running at 2.5ms)
      ### Calibration Note
      Set as fast as possible, since speed controller doesn't expect/considers this rate limitation
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_Pct_CCPM_RateLimitIncrease@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Pct_pct_10_1_s16 
      /* Lower Limit            */      0.1 
      /* Upper Limit            */      3276.7
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3276.8
      /* Extended Upper Limit   */      3276.7000000000003
    /end CHARACTERISTIC
    
