      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
