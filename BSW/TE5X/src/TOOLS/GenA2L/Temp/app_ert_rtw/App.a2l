    /begin CHARACTERISTIC      
      /* Name                   */      TCFCkt_n_CoolingMaxDueToTemp
      /* Long Identifier        */      "### Description
      This is cooling flow actuator (CCPM) max speed limitation due to oil temperature
      ### Usage
      Set to desired maximum speed as function of temperature
      ### Calibration Note
      
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCkt_n_CoolingMaxDueToTemp@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      TCFCve_T_OilTemp
        /* Conversion Method    */      CM_T_T_degC_16_1_s16
        /* Number of Axis Pts   */      16
        /* Lower Limit          */      -40.0
        /* Upper Limit          */      155.0
        AXIS_PTS_REF                    TCFCkn_T_OilTemp
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
      /* Name                   */      TCFCkn_T_OilTemp
      /* Long Identifier        */      "### Description
      This is the oil temperature support point axis for cooling flow actuator (CCPM) max speed limitation due to oil temperature
      ### Usage
      Set to desired oil temperature support points
      ### Calibration Note
      
      "
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCkn_T_OilTemp@ */
      /* Input Quantity         */      TCFCve_T_OilTemp
      /* Record Layout          */      Lookup1D_X_WORD
      /* Maximum Difference     */      0
      /* Conversion Method      */      CM_T_T_degC_16_1_s16
      /* Number of Axis Pts     */      16
      /* Lower Limit            */      -40.0
      /* Upper Limit            */      155.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -2048.0
      /* Extended Upper Limit   */      2047.9375
    /end AXIS_PTS
    
    /begin CHARACTERISTIC      
      /* Name                   */      TCFCkt_Pct_CCPM_DutyCompensation
      /* Long Identifier        */      "### Description
      This is the DC compensation for CCPM needed to maintain a certain speed
      ### Usage
      Set to measured DC needed to maintain each speed in the support point axis
      ### Calibration Note
      Support point axis are calibrated with TCFCkn_n_CCPM_Target
      It may not be possible to achieve all speeds
      This feed-forward is highly dependent on supply voltage to BLDC power stage, currently not compensated for change in voltage
      
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCkt_Pct_CCPM_DutyCompensation@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_Pct_pct_256_1_s16
      /* Lower Limit            */      -128.0
      /* Upper Limit            */      127.9960937
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -128.0
      /* Extended Upper Limit   */      127.99609375
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      NO_INPUT_QUANTITY
        /* Conversion Method    */      CM_T_n_rpm_1_1_s16
        /* Number of Axis Pts   */      16
        /* Lower Limit          */      0.0
        /* Upper Limit          */      32767.0
        AXIS_PTS_REF                    TCFCkn_n_CCPM_Target
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
      /* Name                   */      TCFCkn_n_CCPM_Target
      /* Long Identifier        */      "### Description
      This is the support point axis for DC compensation for CCPM needed to maintain a certain speed
      ### Usage
      Set to desired support points
      ### Calibration Note
      
      "
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCkn_n_CCPM_Target@ */
