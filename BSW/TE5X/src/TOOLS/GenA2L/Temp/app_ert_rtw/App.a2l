    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_KisspointAdaptionSamplesBetweenPoints 
      /* Long Identifier        */      "Adaptionfill, this sets how often the algorithm shall set points used for linear approximation of pressure buildup"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_KisspointAdaptionSamplesBetweenPoints@ */ 
