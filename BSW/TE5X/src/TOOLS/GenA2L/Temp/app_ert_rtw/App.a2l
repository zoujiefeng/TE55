      /* Number of Axis Pts     */      16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end AXIS_PTS
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_I_CCP_BSW_CurrentLimit 
      /* Long Identifier        */      "### Description
      This is the BSW current limit for CCP BLDC Phase Current
      ### Usage
      Set to the same value as used in BSW
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_I_CCP_BSW_CurrentLimit@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_I_A_Float32 
      /* Lower Limit            */      0.1 
      /* Upper Limit            */      3.4E+38
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_K_CCP_BSW_CurrentLimit 
      /* Long Identifier        */      "Low pass filter koefficient =  deltaT/T
      Where deltaT is periodicity for the filter, here 1 sec.
      And T is timeconstant for filter.
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_K_CCP_BSW_CurrentLimit@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_K_NA_Float32 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_e_CCPM_Source 
      /* Long Identifier        */      "### Description
      This sets the source of CCPM actuator control
      ### Usage
      Set to TCFCce_e_CCPM_Source_FlowRequest to set target speed based on cooling flow request
      Set to TCFCce_e_CCPM_Source_SpeedTarget to set target speed to calibration input TCFCkn_n_CCPM_Target
      Set to TCFCce_e_CCPM_Source_DC_Target to set output duty-cycle to calibration input TCFCke_Pct_CCPM_DC
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_e_CCPM_Source@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_TCFCte_e_CCPM_Source 
      /* Lower Limit            */      0 
      /* Upper Limit            */      5
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFCke_e_CCPM_Status 
      /* Long Identifier        */      "### Description
      This sets the CCPM BLDC Command Status, this needs to be set/enabled manually
      ### Usage
      Set to desired CCPM BLDC Command Status
      ### Calibration Note
      This needs to be enabled to be able to run CCPM BLDC motor"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFCke_e_CCPM_Status@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_TCFCte_e_St_ElM 
      /* Lower Limit            */      15 
      /* Upper Limit            */      255
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
