      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_r_SumCurMargin_CAP_CurrentLimit 
      /* Long Identifier        */      "### Description
      This is the marging target of SumCur Y value by limiting CAP phase current. The flow needs to be reduced down to MinLubrication for CAP limitation to be enalbed though.
      ### Usage
      Set to desired margin of SumCur load by limiting CAP Phase current
      ### Calibration Note
      No lubrication request and no cooling request, will result in being at MinLubrication.
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_r_SumCurMargin_CAP_CurrentLimit@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_Float32 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      2.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
