      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_CAPM_PressureTestSequenceNumberOfPhases@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u8 
      /* Lower Limit            */      1.0 
      /* Upper Limit            */      100.0
      EXTENDED_LIMITS
