      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_AtPressureTargetDelayForLoadDetermination 
      /* Long Identifier        */      "This is the stabilization delay for current and power estimation, the actual pressure needs to have been close enough to target pressure for this amount of time (count of 5ms sample time)"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_AtPressureTargetDelayForLoadDetermination@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_CAPM_MaxEnableTimeAfterPressRequest 
      /* Long Identifier        */      "This specifies the maximum time the pressure controller is allowed to continue to request speed after the requested pressure isn't high enough to enable controller, in counts of sample time (@5ms)"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_CAPM_MaxEnableTimeAfterPressRequest@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_DebounceTieUpOccured 
      /* Long Identifier        */      "This cal states the number of SWU executions for debouncing the tie-up occured this key on decision."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_DebounceTieUpOccured@ */ 
      /* Record Layout          */      Scalar_UWORD 
