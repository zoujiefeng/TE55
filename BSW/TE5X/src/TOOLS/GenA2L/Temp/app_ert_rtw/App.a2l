    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_e_CAPM_Status 
      /* Long Identifier        */      "### Description
      This sets the CAPM BLDC Command Status, this needs to be set/enabled manually
      ### Usage
      Set to desired CAPM BLDC Command Status
      ### Calibration Note
      This needs to be enabled to be able to run CAPM BLDC motor"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_e_CAPM_Status@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_CLPCte_e_St_ElM 
      /* Lower Limit            */      15 
      /* Upper Limit            */      255
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCie_e_CAPM_PressureControl 
      /* Long Identifier        */      "### Description
      Override for target for CAPM pressure controller
      ### Usage
      Set to desired override mode when needed, if test sequence generator or manual target is needed.
      ### Calibration Note
      Shall be set CLPCce_e_CAPM_Source_No_Override in production intended SW."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCie_e_CAPM_PressureControl@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_CLPCte_e_CAPM_Override 
      /* Lower Limit            */      0 
      /* Upper Limit            */      5
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCie_e_CAPM_SpeedControl 
      /* Long Identifier        */      "### Description
      Override for target for CAPM speed controller
      ### Usage
      Set to desired override mode when needed, if test sequence generator or manual target is needed.
      ### Calibration Note
      Shall be set CLPCce_e_CAPM_Source_No_Override in production intended SW."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCie_e_CAPM_SpeedControl@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_CLPCte_e_CAPM_Override 
      /* Lower Limit            */      0 
      /* Upper Limit            */      5
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCie_n_CAPM_TargetSpeed 
      /* Long Identifier        */      "### Description
      This is the manual target speed for CAPM speed controller
      ### Usage
