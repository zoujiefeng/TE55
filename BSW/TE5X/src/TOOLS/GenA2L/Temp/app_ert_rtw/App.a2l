    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_BOOLEAN
      /* Long identifier        */      "Q = V"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%1.0"
      /* Units                  */      "Bool"
      /* Coefficients           */      COEFFS 0  1  0  0  0  1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_K_NA_8_1_s16
      /* Long identifier        */      "Q = V*8.000000"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%7.3"
      /* Units                  */      "NA (dependent upon the gain)"
      /* Coefficients           */      COEFFS 0  8  0  0  0  1
    /end COMPU_METHOD
    
    
  
  
