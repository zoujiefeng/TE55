    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_DisableCAP_ForceClutchOpen 
      /* Long Identifier        */      "### Description
      This sets the delay after ForceClutchOpen function action is set that the CAP actuator will be disabled.
      The disabling of CAP will be turned off if the delay is set to maximum value (65535)
      ### Usage
      Set to desired delay (in counts of periodic sample time, 10ms) before disabling CAP actuator
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_DisableCAP_ForceClutchOpen@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_FillCompensationAfterFill 
      /* Long Identifier        */      "This specifies the maximum time to allow fill compensation after pressure controller state has switched from Fill"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_FillCompensationAfterFill@ */ 
      /* Record Layout          */      Scalar_UWORD 
