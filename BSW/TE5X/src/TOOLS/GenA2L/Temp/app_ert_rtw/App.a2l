    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_b_Busbar_EnableTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This enables indicating if Busbar is close to overcurrent
      ### Usage
      Set to true if close to overcurrent shall be indicated for Busbar
      ### Calibration Note
      The indication is set when TCFRve_r_Busbar_Y reaches TCFRke_r_Busbar_LatchTooCloseToOverCurrent
      The indication is released when TCFRve_r_Busbar_Y has gone down to TCFRke_r_Busbar_ReleaseTooCloseToOverCurrent
      BSW will BLDCs when TCFRve_r_Busbar_Y is greater than 1"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_b_Busbar_EnableTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_b_Busbar_OverCurrent_UseBSW_Limit_X 
      /* Long Identifier        */      "### Description
      This enables indicating using the BSW Busbar BLDC current limit
      ### Usage
      Set to true to use information from BSW as well as (max of) the calculated value in TCFR
      Set to false to only use the calculated value in TCFR
      ### Calibration Note
      The BSW value can be measured with TCFRve_r_Busbar_BSW_X and the TCFR value with TCFRve_r_Busbar_ASW_X
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_b_Busbar_OverCurrent_UseBSW_Limit_X@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TCFRke_b_Busbar_OverCurrent_UseBSW_Limit_Y 
      /* Long Identifier        */      "### Description
      This enables indicating using the BSW Busbar BLDC filtered overcurrent limit
      ### Usage
      Set to true to use information from BSW as well as (max of) the calculated value in TCFR
      Set to false to only use the calculated value in TCFR
      ### Calibration Note
      The BSW value can be measured with TCFRve_r_Busbar_BSW_Y and the TCFR value with TCFRve_r_Busbar_ASW_Y
      "
