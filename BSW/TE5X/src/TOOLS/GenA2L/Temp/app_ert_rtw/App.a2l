      /* Name                   */      CLPCke_p_ClutchOpenPressureRequest 
      /* Long Identifier        */      "Pressure request when clutch is requested open, but engine is running (ie pressure is possible). This cal helps pressure controller to settle for temperature dependence etc."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_ClutchOpenPressureRequest@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
