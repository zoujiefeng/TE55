    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_M_RC_DrgTrq_GenTLim 
      /* Long Identifier        */      "The absolute value of the generator torque must be below this limit in order to run the clutch drag torque too high diagnostic."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_M_RC_DrgTrq_GenTLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_M_Nm_32_1_s16 
      /* Lower Limit            */      -1024.0 
      /* Upper Limit            */      1023.96875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -1024.0
      /* Extended Upper Limit   */      1023.96875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_p_RC_ClTrq_PresLim 
