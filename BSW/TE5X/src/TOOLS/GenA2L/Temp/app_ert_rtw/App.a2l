      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAP_EnableTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This enables indicating if CAPM BLDC is close to overcurrent
      ### Usage
      Set to true if close to overcurrent shall be indicated for CAPM BLDC
      ### Calibration Note
      The indication is set when CLPCve_r_CAP_Y reaches CLPCke_r_CAP_LatchTooCloseToOverCurrent
      The indication is released when CLPCve_r_CAP_Y has gone down to CLPCke_r_CAP_ReleaseTooCloseToOverCurrent
      BSW will cut CAPM BLDC for overcurrent when CLPCve_r_CAP_Y is greater than 1"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAP_EnableTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_CAP_Y_EnableCurrentLoad 
      /* Long Identifier        */      "### Description
      This enables using current load for the CAP phase overcurrent protection, with possibility to calibrate a margin.
      If disabled, the CAP BLDC is constantly being limited relative to the current limit, regardless if the current-load value is low or not, but the current limit could be lowered due too high current load instead.
      If enabled, the allowed pressure is proportionally reduced, so that the pressure would be at the current limit when the current load is at cut-off limit (1) minus the margin (CLPCke_r_CAP_Y_OverCurrentMargin)
      ### Usage
      Set to true to enable using current load estimation value
      Set to false to always try to not exceed current limit
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_CAP_Y_EnableCurrentLoad@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0 
      /* Upper Limit            */      1
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
