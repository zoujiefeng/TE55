    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_a_kphps_16_1_s16
      /* Long identifier        */      "Q = V*16.000000"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%8.4"
      /* Units                  */      "kphps (kilometers / hour / second  (kph/s))"
      /* Coefficients           */      COEFFS 0  16   0   0   0   1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_T_degC_16_1_s16
