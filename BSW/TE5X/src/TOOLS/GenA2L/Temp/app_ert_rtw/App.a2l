      /* Long Identifier        */      "Adjustmentfactor, ratio of the difference between old stored kisspoint and newly found kisspoint that shall be used for adjustement of new kisspoint"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_r_NA_NewAdaptionAdjustementFactor@ */ 
