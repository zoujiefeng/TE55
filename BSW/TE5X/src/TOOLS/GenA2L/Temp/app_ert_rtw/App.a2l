    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_r_CAP_Efficiency 
      /* Long Identifier        */      "### Description
      This is the estimated CAPM hydromechanical efficiency
      ### Usage
      Set to estimated CAPM hydromechanical efficiency
      ### Calibration Note
      This is used by the CAPM speed controller feed forward due to clutch pressure"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_r_CAP_Efficiency@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
