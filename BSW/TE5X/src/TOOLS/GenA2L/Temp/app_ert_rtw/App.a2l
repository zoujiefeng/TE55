    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_MaxKissPointAdaptionFill 
      /* Long Identifier        */      "Maximum time allowed to be in kisspoint adaption state, when timeout it will fall back to normal fill"
      /* Type                   */      VALUE 
