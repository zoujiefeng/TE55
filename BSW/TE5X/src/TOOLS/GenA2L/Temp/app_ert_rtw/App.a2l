      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%8.4"
      /* Units                  */      "degC (degrees Celsius  (deg C))"
      /* Coefficients           */      COEFFS 0  16   0   0   0   1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
      /* Name of CompuMethod    */      CM_T_BOOLEAN
      /* Long identifier        */      "Q = V"
      /* Conversion Type        */      RAT_FUNC
      /* Format                 */      "%1.0"
      /* Units                  */      "Bool"
      /* Coefficients           */      COEFFS 0  1  0  0  0  1
    /end COMPU_METHOD
    
    /begin COMPU_METHOD
