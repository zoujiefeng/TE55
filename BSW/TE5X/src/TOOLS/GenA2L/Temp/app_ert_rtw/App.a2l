    /begin CHARACTERISTIC      
      /* Name                   */      CLPCkt_n_FillPressureControlRelativeMaxSpeed
      /* Long Identifier        */      "### Description
      This is the maximum target speed for fill pressure controller relative to feed-forward target rpm based on how close to kiss point the pressure is
      ### Usage
      Set to desired maximum speed, relative to feed-forward, when in filling state
      ### Calibration Note
      The purpose here is to limit the CAPM speed when approaching kisspoint, since the pressure buildup increase rapidly when going above kisspoint.
      Thus to avoid a uncontrollable pressure spike, the target speed could be limited when close to kiss-point
      "
      /* Characteristic Type    */      CURVE
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCkt_n_FillPressureControlRelativeMaxSpeed@ */
      /* Record Layout          */      Lookup1D_WORD
      /* Maxdiff                */      0
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16
      /* Lower Limit            */      0.0
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /begin AXIS_DESCR                 
        /* Description of X-Axis Points */
        /* Axis Type            */      COM_AXIS
        /* Reference to Input   */      NO_INPUT_QUANTITY
        /* Conversion Method    */      CM_T_p_kPa_32_1_u16
        /* Number of Axis Pts   */      2
        /* Lower Limit          */      0.0
        /* Upper Limit          */      2047.96875
        AXIS_PTS_REF                    CLPCkn_p_FillPressureControlRelativeMaxSpeed
      /end AXIS_DESCR
    /end CHARACTERISTIC
    
    /begin AXIS_PTS
