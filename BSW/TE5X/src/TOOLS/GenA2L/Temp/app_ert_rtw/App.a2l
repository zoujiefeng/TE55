      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_MinPreparePressure 
      /* Long Identifier        */      "Minimum possible prepare pressure"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_MinPreparePressure@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_OddMaxAllowedClutchOilPress 
      /* Long Identifier        */      "This cal is to protect clutch from being exposed to excessive oil pressures."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_OddMaxAllowedClutchOilPress@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      10000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_OddMaxAllowedClutchOilPressForIOC 
      /* Long Identifier        */      "This cal is to protect clutch from being exposed to excessive oil pressures.
      This calibration allows for higher pressure than normal max limit for using CAP IOCs
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_OddMaxAllowedClutchOilPressForIOC@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      10000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_PreparePressureRelativeToKisspointEven 
      /* Long Identifier        */      "### Description
      This sets the target prepare pressure relative to kisspoint for Odd clutch, used when torque request is zero.
      ### Usage
      Set to desired offset for target prepare pressure relative to kisspoint for Odd clutch
      ### Calibration Note
      Negative value"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_PreparePressureRelativeToKisspointEven@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      -32768.0 
      /* Upper Limit            */      0.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_ToleranceForBeingAtPrepare 
      /* Long Identifier        */      "This is the tolerance for being at pressure prepare target (i.e. deviation between prepare target and actual not greater than this value), this is used to indicate that the prepare state request is complete"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_ToleranceForBeingAtPrepare@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_ToleranceForBeingAtTarget 
      /* Long Identifier        */      "This is the tolerance for being at pressure target (i.e. deviation between target and actual not greater than this value), this is used to indicate that the ingear state request is complete and also if it's possible to estimate current and power to pressure ratio"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_ToleranceForBeingAtTarget@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCka_Cnt_CAPM_PressureTestSequencePhaseDuration 
      /* Long Identifier        */      "### Description
      This is the duration for each phase (up to 10 phases usable) for target pressure sequence generator for Clutch Actuator Pump Motor
      ### Usage
      Set to desired duration for each phase in counts of periodic sample time (running at 0.005ms, so 200 counts => 1 second)
      ### Calibration Note
      For steps, use 0 or 1 counts.
      
      "
      /* Type                   */      VAL_BLK 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCka_Cnt_CAPM_PressureTestSequencePhaseDuration@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      65535.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
      /* Array Size             */
      NUMBER                            100
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCka_Cnt_CAPM_SpeedTestSequencePhaseDuration 
      /* Long Identifier        */      "### Description
      This is the duration for each phase (up to 10 phases usable) for target speed sequence generator for Clutch Actuator Pump Motor
      ### Usage
      Set to desired duration for each phase in counts of periodic sample time (running at 0.005ms, so 200 counts => 1 second)
      ### Calibration Note
      For steps, use 0 or 1 counts.
      
      "
      /* Type                   */      VAL_BLK 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCka_Cnt_CAPM_SpeedTestSequencePhaseDuration@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      65535.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
      /* Array Size             */
      NUMBER                            100
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_Cnt_AdaptionFillSpeedCond 
      /* Long Identifier        */      "Condition for adaptionfill (finding kisspoint), when in in active adaptionfill state the for CAP-speed has been close enough of target speed for this amount of samples (@5ms) before starting to find the kisspoint"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_Cnt_AdaptionFillSpeedCond@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
