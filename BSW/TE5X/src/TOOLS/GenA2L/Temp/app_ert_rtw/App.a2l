    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_cnt_UseMotorSpdToCalcDerivative 
      /* Long Identifier        */      "###Description
      It is possible to choose which input to be used to calculate 1st and 2nd derivative of P1 rotational speed
      ###Calibration
      1 -> ISG Motor Speed used
      2 -> EPOSve_n_EngSpd used (default)
      3 -> LP filtered PORSve_n_P1MtrSpd
      4--> LP filtered PORSve_n_EngSpd used
      5->  Internaly filtered calculated rotational speed used. (PORSve_n_P1RotationalSpeed)
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_cnt_UseMotorSpdToCalcDerivative@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u8 
      /* Lower Limit            */      1.0 
      /* Upper Limit            */      5.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      255.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_b_2nd_P1Derivative_OB 
      /* Long Identifier        */      "###Description
      PORSve_d2n_P1SecondDerivative overide boolean,
      ###Calibration
      If this signal is True then PORSke_d2n_2nd_P1Derivative_OV will be bypassed to PORSve_d2n_P1SecondDerivative
      ###Usage
      For hardware test purpose
      
      
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_b_2nd_P1Derivative_OB@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_b_ByPassEposDerivatives 
      /* Long Identifier        */      "###Description
      This value will bypass derivative calculations from EPOS. Epos calculation is synced to engine speed.
      ###Calibration
      True(1) -> EPOS derivatives will be used
      False(0) -> PORS internal derivatives will be used
      ###Usage
      Default cal will be internal calculation / False(0)
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_b_ByPassEposDerivatives@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_b_BypassEngSpd 
      /* Long Identifier        */      "If this parameter is set to true, output and validity will be bypassed.
      
      PORSve_n_P1RotationalSpeed will always equal SWINve_n_EngSpd
      and PORSve_e_P1RotationalSpeedVld will equal SWINve_e_EngSpdValidity
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_b_BypassEngSpd@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      PORSke_b_DerivativeWithAvgFilt 
      /* Long Identifier        */      "###Descritpion
      Two ways how to calculate derivative is implemented.
      ###Calibration
      To use average fillter to calculate first derivative set this boolean to 1 (40ms delay) probably the best when source is engine sync
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@PORSke_b_DerivativeWithAvgFilt@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.0
    /end CHARACTERISTIC
    
