      /* Lower Limit            */      0.0 
      /* Upper Limit            */      20.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1023.984375
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      VSPEke_b_UseDrivenwheels4COGUnsigned 
      /* Long Identifier        */      "When set to 1 we will use driven wheel speed to calculate vehicle speed
      useful for benchtests
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@VSPEke_b_UseDrivenwheels4COGUnsigned@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
