    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_FillPressureControllerDecreaseRateLim 
      /* Long Identifier        */      "### Description
      This enables sets the target speed decrease rate-limit for CAPM pressure control when in filling state
      ### Usage
      Set to maximum decrease rate of target speed for pressure controller when in filling state, in rpm per sample (at 5ms)
      ### Calibration Note
      The speed limits have precedence over rate, thus the output can always be limited (towards zero) faster than any rate limit."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_FillPressureControllerDecreaseRateLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768.0 
      /* Upper Limit            */      -1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_FillPressureControllerIncreaseRateLim 
      /* Long Identifier        */      "### Description
      This enables sets the target speed increase rate-limit for CAPM pressure control when in filling state
      ### Usage
      Set to maximum increase rate of target speed for pressure controller when in filling state, in rpm per sample (at 5ms)
      ### Calibration Note
      The speed limits have precedence over rate, thus the output can always be limited (towards zero) faster than any rate limit."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_FillPressureControllerIncreaseRateLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      1.0 
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_MinSpeedToEnableController 
      /* Long Identifier        */      "This is the delay for disabling CAPM speed controller, if below CLPCke_Cnt_DelayToDisableSpeedController for more time than specified with with this parameter (in counts of 2.5ms sample time) then the controller will be disabled and output duty-cycle set to 0"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_MinSpeedToEnableController@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_PressureControllerDecreaseRateLim 
      /* Long Identifier        */      "### Description
      This enables sets the target speed decrease rate-limit for CAPM pressure control
      ### Usage
      Set to maximum decrease rate of target speed for pressure controller, in rpm per sample (at 5ms)
      ### Calibration Note
      The speed limits have precedence over rate, thus the output can always be limited (towards zero) faster than any rate limit."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_PressureControllerDecreaseRateLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768.0 
      /* Upper Limit            */      -1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_PressureControllerIncreaseRateLim 
      /* Long Identifier        */      "### Description
      This enables sets the target speed increase rate-limit for CAPM pressure control
      ### Usage
      Set to maximum increase rate of target speed for pressure controller, in rpm per sample (at 5ms)
      ### Calibration Note
      The speed limits have precedence over rate, thus the output can always be limited (towards zero) faster than any rate limit."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_PressureControllerIncreaseRateLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      1.0 
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_CAPM_PressureControllerMaxSpeed 
      /* Long Identifier        */      "### Description
      This is the maximum CAPM speed to be used by CAPM pressure controller
      ### Usage
      Set to desired maximum CAPM speed for pressure controller
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_CAPM_PressureControllerMaxSpeed@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_MaxTransInputSpeedForClutchIOCs 
      /* Long Identifier        */      "### Description
      This sets the maximum transmission input speed (absolute value) for which it's allowed to activate (and keep active) CAP DID IOCs.
      ### Usage
      Set to maximum transmission input speed to allow CAP IOCs.
      ### Calibration Note"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_MaxTransInputSpeedForClutchIOCs@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      32767.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_PressureControlMinSpeedAboveKisspoint 
      /* Long Identifier        */      "### Description
      This is a separate mininum speed for CAPM pressure controller when above fill phase and target is above kisspoint
      ### Usage
      Set to desired minimum CAPM pressure controller limit when both actual and target pressure is above kisspoint
      ### Calibration Note
      To limit usage of negative speed to lower pressure when no intention to open clutch
      There is a general minimum speed limit as well, maximum value will be used for limitation"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_PressureControlMinSpeedAboveKisspoint@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768.0 
      /* Upper Limit            */      0.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_PressureControlRelativeMaxSpeed 
      /* Long Identifier        */      "Relative to feed-forward limit
      I.e. the maximum limit for the actual PID-controller
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_PressureControlRelativeMaxSpeed@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
