    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_r_RC_ClTrq_GearRatio 
      /* Long Identifier        */      "This parameter defines the gear ratio between the generator and the traction motor."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_r_RC_ClTrq_GearRatio@ */ 
      /* Record Layout          */      Scalar_FLOAT32_IEEE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_Float32 
      /* Lower Limit            */      -3.4E+38 
      /* Upper Limit            */      3.4E+38
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3.4E+38
      /* Extended Upper Limit   */      3.4E+38
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_e_RC_DrgTrq_ICEOffCond 
      /* Long Identifier        */      "Calibration indicating what state is reported when the internal combustion engine is not running."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_e_RC_DrgTrq_ICEOffCond@ */ 
      /* Record Layout          */      Scalar_UBYTE 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_SSSCte_e_EngineStatus 
      /* Lower Limit            */      0 
      /* Upper Limit            */      6
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0
      /* Extended Upper Limit   */      0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_n_RC_ClTrq_SlipLim 
      /* Long Identifier        */      "This parameter defines the maximum deviation between the generator and traction motor. It the rotational speed difference is greater than this a clutch torque capacity insufficient fault will be detected."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_n_RC_ClTrq_SlipLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_n_RC_ClTrq_UseSmallDiffFiltBelow 
      /* Long Identifier        */      "Switchpoint for the small and large filter constant usage. If slip speed is smaller than this parameter the TSSDke_K_RC_ClTrq_SmallDiffFiltConst will be used by the filter. Otherwise the TSSDke_K_RC_ClTrq_LargeDiffFiltConst will be used."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_n_RC_ClTrq_UseSmallDiffFiltBelow@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_n_RC_DrgTrq_GenSpdLim 
      /* Long Identifier        */      "When the generator spins faster than this limit the diagnosis will detect a high clutch drag torque fault."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_n_RC_DrgTrq_GenSpdLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_n_RC_DrgTrq_MotChkLim 
      /* Long Identifier        */      "When the traction motor spins faster than this limit a high drag torque check will be performed"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_n_RC_DrgTrq_MotChkLim@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -32768 
      /* Upper Limit            */      32767
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_Cnt_RC_ClTrq_DiagCounts 
      /* Long Identifier        */      "This parameter defines the number of samples required to test before reporting PASS for the clutch capacity insufficient rationality diagnosis."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_Cnt_RC_ClTrq_DiagCounts@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      65535
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      65535.0
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      TSSDke_Cnt_RC_DrgTrq_DiagCounts 
      /* Long Identifier        */      "This parameter defines the number of samples required to test before reporting PASS for the clutch capacity insufficient rationality diagnosis."
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TSSDke_Cnt_RC_DrgTrq_DiagCounts@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_Cnt_Num_1_1_u16 
      /* Lower Limit            */      0 
