      /* Lower Limit            */      0 
      /* Upper Limit            */      2047.96875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      2047.96875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_StablePressureTolerance 
      /* Long Identifier        */      "This is the stabilization tolearance for stable pressure for current and power estimation, the actual pressure needs to be kept steady (not deviate more than this tolerance) for the time specified with CLPCke_Cnt_StablePressureDelay"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_StablePressureTolerance@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_32_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      2047.96875
      EXTENDED_LIMITS
