    /begin CHARACTERISTIC 
      /* Name                   */      CLCOke_r_MaxActualTorqueRelativeTIRC_ReqAtLash 
      /* Long Identifier        */      "Enables usage of max of actual total P1 torque and TIRC ReqAtLash.
      If set to any value less tan or equal to 1, then the target won't be greater then TIRC ReqAtLash
      Set to any value greater than 1, then actual torque can increase the target with that factor (if actual torque is that high)
      
      By setting it to 2, then actual torque can raise the target to twice the TIRC ReqAtLash torque.
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLCOke_r_MaxActualTorqueRelativeTIRC_ReqAtLash@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_8192_1_u16 
      /* Lower Limit            */      0 
      /* Upper Limit            */      7.9998779296875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      7.9998779296875
    /end CHARACTERISTIC
    
