    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_r_CAP_LatchTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for setting and latching indication that CAPM BLDC is close to overcurrent
      ### Usage
      Set to desired ratio for indicating CAPM BLDC too close to overcurrent, will set latching when CLPCve_r_CAP_Y is greater than or equal to this value
      ### Calibration Note
      This value is compared to CLPCve_r_CAP_Y, when this exceeds 1 the CAPM powerstage will be turned off by BSW
      The indication is released when CLPCve_r_CAP_Y is equal or less than CLPCke_r_CAP_ReleaseTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with CLPCke_CAP_EnableTooCloseToOverCurrent"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_r_CAP_LatchTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_r_CAP_ReleaseTooCloseToOverCurrent 
      /* Long Identifier        */      "### Description
      This is the ratio for releasing indication that CAPM BLDC is close to overcurrent
      ### Usage
      Set to desired ratio for releasing CAPM BLDC too close to overcurrent, will release latching when CLPCve_r_CAP_Y is equal to or less than this value
      ### Calibration Note
      This value is compared to CLPCve_r_CAP_Y, when this exceeds 1 the CAPM powerstage will be turned off by BSW
      The indication is set and latched when CLPCve_r_CAP_Y is greater than or equal to CLPCke_r_CAP_LatchTooCloseToOverCurrent
      The too close to overcurrent indication needs to be enabled with CLPCke_CAP_EnableTooCloseToOverCurrent"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_r_CAP_ReleaseTooCloseToOverCurrent@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_r_CAP_Y_OverCurrentMargin 
      /* Long Identifier        */      "### Description
      This is the margin for CAP overcurrent filter load value Y, used to prevent CAP Phase Overcurrent.
      The speed limit will be reduced when the margin (relative to 1) is smaller than this value
      ### Usage
      Set to desired minimum margin for filtered load current before target speed is reduced
      ### Calibration Note
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_r_CAP_Y_OverCurrentMargin@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_r_NA_32768_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      0.7
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1.999969482421875
    /end CHARACTERISTIC
    
