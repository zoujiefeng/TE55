      /* Lower Limit            */      -100.0 
      /* Upper Limit            */      0.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -3276.8
      /* Extended Upper Limit   */      3276.7000000000003
    /end CHARACTERISTIC
    
