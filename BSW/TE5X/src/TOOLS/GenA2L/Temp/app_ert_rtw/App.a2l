    /begin CHARACTERISTIC 
      /* Name                   */      CLPCka_n_CAPM_SpeedTestSequencePhaseTarget 
      /* Long Identifier        */      "### Description
      This is the target speed for each phase (up to 10 phases usable) for target speed sequence generator for Clutch Actuator Pump Motor
      ### Usage
      Set to desired target speed for each phase in rpm, the output during the phase will be interpolated between last phase output and the current phase target.
      ### Calibration Note
      
      "
      /* Type                   */      VAL_BLK 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCka_n_CAPM_SpeedTestSequencePhaseTarget@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_n_rpm_1_1_s16 
      /* Lower Limit            */      -14000.0 
      /* Upper Limit            */      14000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /* Array Size             */
      NUMBER                            100
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCka_p_CAPM_PressureTestSequencePhaseTarget 
      /* Long Identifier        */      "### Description
      This is the target pressure for each phase (up to 10 phases usable) for target pressure sequence generator for Clutch Actuator Pump Motor
      ### Usage
      Set to desired target pressure for each phase in kPa, the output during the phase will be interpolated between last phase output and the current phase target.
      ### Calibration Note
      
      
      "
      /* Type                   */      VAL_BLK 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCka_p_CAPM_PressureTestSequencePhaseTarget@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_1_1_s16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      2000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      -32768.0
      /* Extended Upper Limit   */      32767.0
      /* Array Size             */
      NUMBER                            100
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_n_AdaptionFillMaxError 
      /* Long Identifier        */      "Condition for adaptionfill (finding kisspoint), when in in active adaptionfill state the for CAP-speed error relative the target speed is allowed to be max this value, there is also a time delay during the speed condition needs to be fulfilled before trying to find kisspoint"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_n_AdaptionFillMaxError@ */ 
      /* Record Layout          */      Scalar_SWORD 
      /* Maximum Difference     */      0 
