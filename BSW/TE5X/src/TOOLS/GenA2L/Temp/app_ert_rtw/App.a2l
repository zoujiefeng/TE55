    /begin CHARACTERISTIC 
      /* Name                   */      VSPEke_v_EstimateHigh 
      /* Long Identifier        */      "Below this limit the Validity is kept and above we can make a new estimation"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@VSPEke_v_EstimateHigh@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_v_kph_64_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      50.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      1023.984375
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      VSPEke_v_EstimateLow 
      /* Long Identifier        */      "Under this limit we set SignalValidity to InValid"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@VSPEke_v_EstimateLow@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
