      /* Long Identifier        */      "Fan request to be used for \"high\" fan request"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@TCFRke_Pct_FanRequestHigh@ */ 
      /* Record Layout          */      Scalar_SWORD 
