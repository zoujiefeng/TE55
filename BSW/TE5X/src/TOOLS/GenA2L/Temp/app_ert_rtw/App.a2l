    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_KisspointUpperAdaptionLimit 
      /* Long Identifier        */      "Maximum adaption limit for kisspoint"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_KisspointUpperAdaptionLimit@ */ 
      /* Record Layout          */      Scalar_UWORD 
