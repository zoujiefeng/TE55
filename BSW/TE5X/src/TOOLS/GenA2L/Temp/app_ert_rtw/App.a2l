      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCie_p_CAPM_TargetPressure@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_32_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      2000.0
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      2047.96875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_CAPM_ActualPressureToEnableController 
      /* Long Identifier        */      "### Description
      This is the actual pressure to toggle pressure controller on/off
      ### Usage
      Set to desired actual pressure limit for keeping pressure controller active, if higher than pressure controller is enabled.
      ### Calibration Note
      Pressure controller will be enabled if target pressure or actual is above their respective limit"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_CAPM_ActualPressureToEnableController@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_32_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      2047.96875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      2047.96875
    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_p_CAPM_TargetPressureToEnableController 
      /* Long Identifier        */      "### Description
      This is the target pressure to toggle pressure controller on/off
      ### Usage
      Set to desired target pressure limit for keeping pressure controller active, if higher than pressure controller is enabled.
      ### Calibration Note
      Pressure controller will be enabled if target pressure or actual is above their respective limit"
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_p_CAPM_TargetPressureToEnableController@ */ 
      /* Record Layout          */      Scalar_UWORD 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_p_kPa_32_1_u16 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      2047.96875
      EXTENDED_LIMITS
      /* Extended Lower Limit   */      0.0
      /* Extended Upper Limit   */      2047.96875
    /end CHARACTERISTIC
    
