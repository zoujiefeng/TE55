    /end CHARACTERISTIC
    
    /begin CHARACTERISTIC 
      /* Name                   */      CLPCke_b_EnableFillCompensation 
      /* Long Identifier        */      "### Description
      This enables an extra CAPM speed boost when in fill to reach fill target, unloading the Fill PID controller.
      ### Usage
      Set to TRUE to enable Fill compensation
      ### Calibration Note
      Fill compensation is calibrated with table CLPCkt_n_CAPM_Fill
      "
      /* Type                   */      VALUE 
      /* ECU Address            */      0x0000 /* @ECU_Address@CLPCke_b_EnableFillCompensation@ */ 
      /* Record Layout          */      Scalar_BOOLEAN 
      /* Maximum Difference     */      0 
      /* Conversion Method      */      CM_T_BOOLEAN 
      /* Lower Limit            */      0.0 
      /* Upper Limit            */      1.0
