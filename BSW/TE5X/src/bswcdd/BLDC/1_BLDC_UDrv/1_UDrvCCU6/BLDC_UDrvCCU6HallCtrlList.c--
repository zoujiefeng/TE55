#include "Std_Types.h"

#define PWM_OPEN 1
#define PWM_OFF  0

typedef struct BLDC_CCU6HallCtrlList{
   uint8 u8CurListIndex;
   uint8 u8NextListIndex;
   union{
      struct{
         uint8 PWM1A :1;
         uint8 PWM1B :1;
         uint8 PWM2A :1;
         uint8 PWM2B :1;
         uint8 PWM3A :1;
         uint8 PWM3B :1;
         uint8 Reserved :2;
      }B;
      uint8 U;
   }PwmState;
}BLDC_CCU6HallCtrlList, *PBLDC_CCU6HallCtrlList; 

